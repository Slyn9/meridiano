{
    "name": "slyn9/meridiano",
    "description": "Meridiano, el sistema de diseño de DN Systems: tokens, recetas CSS y componentes para las apps Laravel de DN Systems (React/Inertia y Blade/Livewire).",
    "keywords": ["laravel", "design-system", "tokens", "css", "blade", "react", "tailwindcss"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Slyn9\\Meridiano\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Slyn9\\Meridiano\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.x-dev"
        },
        "laravel": {
            "providers": [
                "Slyn9\\Meridiano\\MeridianoServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
